{
  "name": "mpnames-worker",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler pages dev ./dist --d1 DB",
    "build": "node scripts/build.mjs",
    "deploy": "npm run build && wrangler pages deploy ./dist",
    "push-db": "node scripts/push-db.mjs",
    "push-db:local": "node scripts/push-db.mjs --local",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260708.1",
    "typescript": "^5.8.3",
    "wrangler": "^4.110.0"
  }
}
